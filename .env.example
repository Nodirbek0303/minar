# --- AI provayder (OpenAI-mos har qanday API: OpenAI, Z.ai, v.b.) ---
# Bu faylni .env deb nomlab, kalitni kiriting — AI chat va rasm tahlili to'liq ishlaydi.
# Kalitsiz ham DXF chizmalar to'liq tahlil qilinadi (demo rejim).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Kirish nazorati ---
# APP_PASSWORD berilsa: barcha API va yuklangan fayllar parol bilan himoyalanadi
# va server tarmoqqa ochiladi (0.0.0.0).
# Berilmasa: server FAQAT 127.0.0.1 da ishlaydi (lokal demo).
APP_PASSWORD=
# Frontend manzili (CORS uchun), masalan https://arxai.example.uz
APP_ORIGIN=
# HTTPS orqali ishlatilsa cookie'ni Secure qilish: 1
COOKIE_SECURE=

PORT=3001
